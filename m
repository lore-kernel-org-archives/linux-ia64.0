 }

+/*
+ * Set up a node as the point of contact for system controller
+ * environmental event delivery.
+ */
+static inline int
+ia64_sn_sysctl_event_init(nasid_t nasid)
+{
+        struct ia64_sal_retval rv;
+        SAL_CALL_NOLOCK(rv, SN_SAL_SYSCTL_EVENT, (u64) nasid,
+                        0, 0, 0, 0, 0, 0);
+        return (int) rv.v0;
+}
