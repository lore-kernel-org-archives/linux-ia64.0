+	fpriv->hw_state[i] =3D kmalloc(sizeof(struct ffb_hw_context), GFP_KERNEL);
+	if (fpriv->hw_state[i] =3D NULL)
+		return -1;
+
+	fpriv->hw_state[i]->is_2d_only =3D is_2d_only;
+
+	/* Plus one because 0 is the special DRM_KERNEL_CONTEXT. */
+	return i + 1;
