-	(2 * ARRAY_SIZE(salinfo_log_name)) +		/* /proc/sal/mca/{event,data} */
+	(3 * ARRAY_SIZE(salinfo_log_name)) +		/* /proc/sal/mca/{event,data,inject} */
 	1];						/* /proc/sal */
 
 /* Some records we get ourselves, some are accessed as saved data in buffers
