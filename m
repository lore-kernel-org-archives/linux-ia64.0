+	[DRM_IOCTL_NR(DRM_IOCTL_ADD_DRAW)]   =3D { drm_adddraw,	  1, 1 },
+	[DRM_IOCTL_NR(DRM_IOCTL_RM_DRAW)]    =3D { drm_rmdraw,	  1, 1 },
