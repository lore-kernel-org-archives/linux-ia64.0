+				buf =3D drm_waitlist_get(&q->waitlist);
+				dma->next_buffer =3D buf;
+				dma->next_queue	 =3D q;
+				if (buf && buf->list =3D DRM_LIST_RECLAIM) {
+					drm_clear_next_buffer(dev);
+					drm_free_buffer(dev, buf);
+				}
+			}
+		} while (next >=3D 0 && !dma->next_buffer);
+		if (dma->next_buffer) {
+			if (!(retcode =3D gamma_do_dma(dev, locked))) {
+				++processed;
+			}
+		}
+	}
