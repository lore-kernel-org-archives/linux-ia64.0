+	do {
+		old  =3D *lock;
+		new  =3D 0;
+		prev =3D cmpxchg(lock, old, new);
+	} while (prev !=3D old);
+	if (_DRM_LOCK_IS_HELD(old) && _DRM_LOCKING_CONTEXT(old) !=3D context) {
