+static int gamma_dma_send_buffers(drm_device_t *dev, drm_dma_t *d)
+{
+	DECLARE_WAITQUEUE(entry, current);
+	drm_buf_t	  *last_buf =3D NULL;
+	int		  retcode   =3D 0;
+	drm_device_dma_t  *dma	    =3D dev->dma;
