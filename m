+static int ffb_alloc_queue(drm_device_t *dev, int is_2d_only)
+{
+	ffb_dev_priv_t *fpriv =3D (ffb_dev_priv_t *) (dev + 1);
+	int i;
+
+	for (i =3D 0; i < FFB_MAX_CTXS; i++) {
