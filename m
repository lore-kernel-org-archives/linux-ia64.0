+				  d->send_indices[i], dma->buf_count - 1);
+			continue;
+		}
+		buf =3D dma->buflist[ idx ];
+		if (buf->pid !=3D current->pid) {
+			DRM_ERROR("Process %d using buffer owned by %d\n",
+				  current->pid, buf->pid);
+			retcode =3D -EINVAL;
+			goto cleanup;
+		}
+		if (buf->list !=3D DRM_LIST_NONE) {
+			DRM_ERROR("Process %d using %d's buffer on list %d\n",
+				  current->pid, buf->pid, buf->list);
+			retcode =3D -EINVAL;
+			goto cleanup;
+		}
