+int drm_lock_take(__volatile__ unsigned int *lock, unsigned int context)
+{
+	unsigned int old, new, prev;
+
+	do {
+		old =3D *lock;
+		if (old & _DRM_LOCK_HELD) new =3D old | _DRM_LOCK_CONT;
+		else			  new =3D context | _DRM_LOCK_HELD;
+		prev =3D cmpxchg(lock, old, new);
+	} while (prev !=3D old);
+	if (_DRM_LOCKING_CONTEXT(old) =3D context) {
+		if (old & _DRM_LOCK_HELD) {
+			if (context !=3D DRM_KERNEL_CONTEXT) {
