+static unsigned long ffb_get_unmapped_area(struct file *filp, unsigned lon=
g hint, unsigned long len, unsigned long pgoff, unsigned long flags)
+{
+	drm_map_t *map =3D ffb_find_map(filp, pgoff << PAGE_SHIFT);
+	unsigned long addr =3D -ENOMEM;
