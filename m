-# CPU/Memory map format:
-#	setenv nodeN_memory_config 0xBSBSBSBS
-#		B=BAnksize (0=3Dunused, 1dM, 2=128M, .., 5-1G, c=3D8M, d=16M, e2M)
-#		S=BAnk enable (0=3Dboth disable, 3=3Dboth enable, 2=BAnk1 enable, 1=BAn=
k0 enable)
