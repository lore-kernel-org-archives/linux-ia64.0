+int gamma_dma(struct inode *inode, struct file *filp, unsigned int cmd,
+	      unsigned long arg)
+{
+	drm_file_t	  *priv	    =3D filp->private_data;
+	drm_device_t	  *dev	    =3D priv->dev;
+	drm_device_dma_t  *dma	    =3D dev->dma;
+	int		  retcode   =3D 0;
