+	drm_queue_t	 *q;
+	drm_buf_t	 *buf;
+	int		 retcode   =3D 0;
+	int		 processed =3D 0;
+	int		 missed;
+	int		 expire	   =3D 20;
+	drm_device_dma_t *dma	   =3D dev->dma;
+#if DRM_DMA_HISTOGRAM
+	cycles_t	 schedule_start;
+#endif
