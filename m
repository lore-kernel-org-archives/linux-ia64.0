+	ctx->xclip =3D upa_readl(&ffb->xclip);		/* X plane clip */
+	ctx->dcss =3D upa_readl(&ffb->dcss);		/* Depth Cue Scale Slope */
+	ctx->vclipmin =3D upa_readl(&ffb->vclipmin);	/* Primary XY clip, minimum =
*/
+	ctx->vclipmax =3D upa_readl(&ffb->vclipmax);	/* Primary XY clip, maximum =
*/
+	ctx->vclipzmin =3D upa_readl(&ffb->vclipzmin);	/* Primary Z clip, minimum=
 */
+	ctx->vclipzmax =3D upa_readl(&ffb->vclipzmax);	/* Primary Z clip, maximum=
 */
+	ctx->dcsf =3D upa_readl(&ffb->dcsf);		/* Depth Cue Scale Front Bound */
+	ctx->dcsb =3D upa_readl(&ffb->dcsb);		/* Depth Cue Scale Back Bound */
+	ctx->dczf =3D upa_readl(&ffb->dczf);		/* Depth Cue Scale Z Front */
+	ctx->dczb =3D upa_readl(&ffb->dczb);		/* Depth Cue Scale Z Back */
+	ctx->blendc =3D upa_readl(&ffb->blendc);		/* Alpha Blend Control */
+	ctx->blendc1 =3D upa_readl(&ffb->blendc1);	/* Alpha Blend Color 1 */
+	ctx->blendc2 =3D upa_readl(&ffb->blendc2);	/* Alpha Blend Color 2 */
